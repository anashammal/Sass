<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes +FollowSymLinks
    </IfModule>

    # 👈🏻 إضافة السطر الحاسم: تعيين server.php كملف الفهرس الأساسي
    DirectoryIndex server.php 

    RewriteEngine On

    # توجيه الملفات العامة (الصور، التنسيقات، الأكواد) إلى مجلد public تلقائياً
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(images|css|js|storage|fonts|assets)/(.*)$ public/$1/$2 [L,NC]

    # توجيه جميع الطلبات الأخرى إلى server.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ server.php/$1 [L]

</IfModule>